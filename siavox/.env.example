# Siavox Configuration

# Google OAuth 2.0 Client ID (for GIS verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Ollama Endpoint Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# SQLite Database URL
DATABASE_URL=sqlite:///./siavox.db

# FastAPI Session Secret Key (for signing session cookies)
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Enable debug mode to bypass Google Authentication and automatically log in a dev user account
DEBUG_MODE=false
